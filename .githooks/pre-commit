#!/bin/sh

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
    printf '%s\n' 'Pre-commit: unable to locate the repository root; commit blocked.' >&2
    exit 1
}

cd "$repo_root" || {
    printf '%s\n' 'Pre-commit: unable to enter the repository root; commit blocked.' >&2
    exit 1
}

if command -v python >/dev/null 2>&1 && python -c 'import sys' >/dev/null 2>&1; then
    python -m unittest discover -s tests -v
    test_status=$?
    if [ "$test_status" -eq 0 ]; then
        printf '%s\n' 'Pre-commit: all tests passed.'
        exit 0
    fi
    printf '%s\n' 'Pre-commit: tests failed; commit blocked.' >&2
    exit "$test_status"
fi

if command -v py >/dev/null 2>&1 && py -3.13 -c 'import sys' >/dev/null 2>&1; then
    py -3.13 -m unittest discover -s tests -v
    test_status=$?
    if [ "$test_status" -eq 0 ]; then
        printf '%s\n' 'Pre-commit: all tests passed.'
        exit 0
    fi
    printf '%s\n' 'Pre-commit: tests failed; commit blocked.' >&2
    exit "$test_status"
fi

printf '%s\n' 'Pre-commit: Python was not found. Install Python 3.13 and make python or py -3.13 available on PATH; commit blocked.' >&2
exit 1